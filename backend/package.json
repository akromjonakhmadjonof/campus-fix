{
  "name": "@campus-fix/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "pnpm build && node scripts/dev.mjs",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "lint": "eslint --max-warnings=0 src test prisma.config.ts",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:compile": "pnpm db:generate && tsc -p tsconfig.test.json",
    "test": "pnpm test:compile && node --test .test-build/test/*.test.js",
    "test:integration": "pnpm test:compile && node --test --test-concurrency=1 .test-build/test/*.integration.js",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs dev",
    "db:deploy": "node scripts/migrate.mjs deploy",
    "db:status": "node scripts/migrate.mjs status",
    "db:seed": "pnpm build && node dist/campus/seed.js",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "sharp": "0.35.5",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@nestjs/common": "12.3.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.0",
    "@nestjs/platform-fastify": "12.3.0",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.4.2",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
