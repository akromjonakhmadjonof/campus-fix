# Loaded from backend/.env when commands run in backend (pnpm --filter sets cwd).
# Deployment variables take precedence. Copy locally and replace password placeholders.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT_BYTES=16384
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Comma-separated trusted proxy IPs/CIDRs only; blank means no proxy trust.
TRUST_PROXY=
SWAGGER_ENABLED=true

# Compose bootstrap role is for local provisioning only. Never use it in the app.
POSTGRES_PASSWORD=replace_with_local_bootstrap_password
MIGRATION_PASSWORD=replace_with_local_migration_password
APP_DB_PASSWORD=replace_with_local_application_password
# URL-encode special characters in passwords below.
DATABASE_URL=postgresql://campus_app:replace_with_local_application_password@127.0.0.1:5432/campus_fix
MIGRATION_DATABASE_URL=postgresql://campus_migrate:replace_with_local_migration_password@127.0.0.1:5432/campus_fix
SHADOW_DATABASE_URL=postgresql://campus_migrate:replace_with_local_migration_password@127.0.0.1:5432/campus_fix_shadow
# Application URL has no query parameters; SSL is controlled here. Production requires true.
DB_SSL=false
# Optional PEM CA file; otherwise use the system trust roots. Verification always stays enabled.
DB_SSL_CA_FILE=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=2000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=3000

# Optional legacy Projects example only. CampusFix reports use local cookies.
# If provided, configure all three together.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# Separate Compose test service on port 5433. Use independently chosen passwords.
TEST_POSTGRES_PASSWORD=replace_with_test_bootstrap_password
TEST_MIGRATION_PASSWORD=replace_with_test_migration_password
TEST_APP_DB_PASSWORD=replace_with_test_application_password

# Writable local photo storage; mount a persistent directory in containers.
UPLOAD_DIR=uploads
# Required only for explicit development/test seeding. Choose a password of 12–128 characters.
SEED_STAFF_PASSWORD=
