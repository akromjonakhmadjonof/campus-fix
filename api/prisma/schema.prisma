generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  REPORTED
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Profile {
  displayName        String?        @db.VarChar(60)
  avatarMediaId      String?        @db.Uuid
  avatar             Media?         @relation("profileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  id                 String         @id @default(uuid()) @db.Uuid
  createdAt          DateTime       @default(now())
  sessions           Session[]
  reports            Report[]
  votes              Vote[]
  media              Media[]
  notifications      Notification[] @relation("notificationRecipient")
  actedNotifications Notification[] @relation("notificationReporter")
  voteEvents         VoteEvent[]
}

model Session {
  id          String        @id @default(uuid()) @db.Uuid
  profileId   String        @db.Uuid
  profile     Profile       @relation(fields: [profileId], references: [id])
  tokenHash   String        @unique
  createdAt   DateTime      @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  sourceLinks LinkRequest[] @relation("linkSource")
  targetLinks LinkRequest[] @relation("linkTarget")

  @@index([profileId, expiresAt], map: "Session_profile_expiry")
}

model LinkRequest {
  id              String   @id @default(uuid()) @db.Uuid
  sourceSessionId String   @db.Uuid
  targetSessionId String?  @db.Uuid
  codeHash        String   @unique
  state           String   @default("open")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  sourceSession   Session  @relation("linkSource", fields: [sourceSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "LinkRequest_source_fkey")
  targetSession   Session? @relation("linkTarget", fields: [targetSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "LinkRequest_target_fkey")

  @@index([sourceSessionId, state], map: "LinkRequest_source_state")
}

model Staff {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  displayName   String
  passwordHash  String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  sessions      StaffSession[]
  events        StatusEvent[]
  resolved      Report[]
  notifications Notification[]
}

model StaffSession {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @db.Uuid
  staff     Staff    @relation(fields: [staffId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
}

model Location {
  id        String     @id @default(uuid()) @db.Uuid
  sourceKey String     @unique
  name      String
  path      String
  sortOrder Int
  parentId  String?    @db.Uuid
  parent    Location?  @relation("tree", fields: [parentId], references: [id])
  children  Location[] @relation("tree")
  reports   Report[]

  @@index([parentId, sortOrder])
}

model IssueGroup {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique
  labelEn   String
  labelEs   String
  sortOrder Int
  types     IssueType[]
}

model IssueType {
  id      String     @id @default(uuid()) @db.Uuid
  code    String     @unique
  labelEn String
  labelEs String
  groupId String     @db.Uuid
  group   IssueGroup @relation(fields: [groupId], references: [id])
  reports Report[]
}

model Report {
  id              String         @id @default(uuid()) @db.Uuid
  reference       Int            @unique @default(autoincrement())
  fixtureKey      String?        @unique
  idempotencyKey  String         @unique
  profileId       String         @db.Uuid
  profile         Profile        @relation(fields: [profileId], references: [id])
  locationId      String         @db.Uuid
  location        Location       @relation(fields: [locationId], references: [id])
  issueTypeId     String         @db.Uuid
  issueType       IssueType      @relation(fields: [issueTypeId], references: [id])
  category        String
  customIssueName String?
  title           String         @db.VarChar(120)
  description     String         @db.VarChar(4000)
  exactLocation   String         @db.VarChar(300)
  status          ReportStatus   @default(REPORTED)
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  resolvedById    String?        @db.Uuid
  resolvedBy      Staff?         @relation(fields: [resolvedById], references: [id])
  votes           Vote[]
  history         StatusEvent[]
  attachments     ReportMedia[]
  notifications   Notification[]
  voteEvents      VoteEvent[]

  @@index([status, createdAt, id])
  @@index([profileId, createdAt])
  @@index([locationId, issueTypeId])
  @@index([createdAt])
  @@index([resolvedById, status])
}

model Vote {
  profileId String   @db.Uuid
  reportId  String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id])
  report    Report   @relation(fields: [reportId], references: [id])
  createdAt DateTime @default(now())

  @@id([reportId, profileId])
}

model StatusEvent {
  id               String        @id @default(uuid()) @db.Uuid
  reportId         String        @db.Uuid
  report           Report        @relation(fields: [reportId], references: [id])
  status           ReportStatus
  fromStatus       ReportStatus?
  actorType        String
  actorDisplayName String?       @db.VarChar(120)
  staffId          String?       @db.Uuid
  staff            Staff?        @relation(fields: [staffId], references: [id])
  note             String        @db.VarChar(500)
  createdAt        DateTime      @default(now())

  notification Notification?

  @@index([reportId, createdAt])
  @@index([status, createdAt])
  @@index([staffId, status])
}

model Media {
  avatarProfiles Profile[]     @relation("profileAvatar")
  id             String        @id @default(uuid()) @db.Uuid
  profileId      String        @db.Uuid
  profile        Profile       @relation(fields: [profileId], references: [id])
  storageKey     String        @unique
  mime           String
  bytes          Int
  sha256         String
  createdAt      DateTime      @default(now())
  attachments    ReportMedia[]
}

model ReportMedia {
  reportId  String @db.Uuid
  mediaId   String @db.Uuid
  sortOrder Int
  report    Report @relation(fields: [reportId], references: [id])
  media     Media  @relation(fields: [mediaId], references: [id])

  @@id([reportId, mediaId])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorType String
  actorId   String?
  action    String
  entityId  String
  createdAt DateTime @default(now())
}

enum NotificationType {
  UPVOTE
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum NotificationActorKind {
  REPORTER
  STAFF
}

model VoteEvent {
  id           String        @id @default(uuid()) @db.Uuid
  reportId     String        @db.Uuid
  report       Report        @relation(fields: [reportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profileId    String        @db.Uuid
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime      @default(now())
  notification Notification?

  @@index([createdAt])
  @@index([reportId])
}

model Notification {
  id               String                @id @default(uuid()) @db.Uuid
  recipientId      String                @db.Uuid
  recipient        Profile               @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorKind        NotificationActorKind
  actorProfileId   String?               @db.Uuid
  actorProfile     Profile?              @relation("notificationReporter", fields: [actorProfileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorStaffId     String?               @db.Uuid
  actorStaff       Staff?                @relation(fields: [actorStaffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorDisplayName String?               @db.VarChar(120)
  type             NotificationType
  reportId         String                @db.Uuid
  report           Report                @relation(fields: [reportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportTitle      String                @db.VarChar(120)
  statusEventId    String?               @unique @db.Uuid
  statusEvent      StatusEvent?          @relation(fields: [statusEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  voteEventId      String?               @unique @db.Uuid
  voteEvent        VoteEvent?            @relation(fields: [voteEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  note             String?               @db.VarChar(500)
  createdAt        DateTime              @default(now())
  readAt           DateTime?

  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt])
}
