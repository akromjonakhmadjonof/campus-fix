    "expo-dev-client": "~58.0.17",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
