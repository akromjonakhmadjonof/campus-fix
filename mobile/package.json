{
  "name": "@campus-fix/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ../scripts/mobile.mjs start",
    "android": "node ../scripts/mobile.mjs android",
    "ios": "node ../scripts/mobile.mjs ios",
    "config": "APP_VARIANT=development expo config",
    "lint": "eslint --max-warnings=0 .",
